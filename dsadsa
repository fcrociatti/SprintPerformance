CREATE TABLE TB_SPRINT (
    ID_SPRINT INT PRIMARY KEY AUTO_INCREMENT,
    NOME_SPRINT VARCHAR(255) NOT NULL,
    DATA_INICIO DATE NOT NULL,
    DATA_FIM DATE NOT NULL,
    ITENS_INICIAIS INT DEFAULT 0,
    TEMPO_REUNIAO_MIN FLOAT DEFAULT 0,
    DESCRICAO TEXT,
    CREATED DATETIME DEFAULT CURRENT_TIMESTAMP()
);

CREATE TABLE TB_SPRINT_DETAILS (
    ID_SPRINT_DETAILS INT PRIMARY KEY AUTO_INCREMENT,
    ISSUE_KEY VARCHAR(50) UNIQUE NOT NULL,
    PROJETO VARCHAR(100) NOT NULL,
    RESPONSAVEL VARCHAR(150) NOT NULL,
    TIPO_ITEM VARCHAR(50),
    CATEGORIA VARCHAR(100),
    PONTOS FLOAT DEFAULT 0,
    DATA_CONCLUSAO DATETIME,
    CLIENTE VARCHAR(150),
    RESUMO TEXT,
    ID_SPRINT INT,
    CREATED DATETIME DEFAULT CURRENT_TIMESTAMP(),
    FOREIGN KEY (ID_SPRINT) REFERENCES TB_SPRINT(ID_SPRINT)
);

CREATE TABLE TB_SPRINT_BACKLOG (
    ID_SPRINT_BACKLOG INT PRIMARY KEY AUTO_INCREMENT,
    ID_SPRINT INT,
    ISSUE_KEY VARCHAR(50) NOT NULL,
    PROJETO VARCHAR(100) NOT NULL,
    RESPONSAVEL VARCHAR(150) NOT NULL,
    PAPEL VARCHAR(50),
    TIPO_ITEM VARCHAR(50),
    CLIENTE VARCHAR(150),
    RESUMO TEXT,
    DATA_CRIACAO VARCHAR(50), 
    CREATED DATETIME DEFAULT CURRENT_TIMESTAMP(),
    FOREIGN KEY (ID_SPRINT) REFERENCES TB_SPRINT(ID_SPRINT),
    UNIQUE (ID_SPRINT, ISSUE_KEY)
);


